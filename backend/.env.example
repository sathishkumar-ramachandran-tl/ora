# Copy to backend/.env and fill in your own values.
# DATABASE_URL is required — the app will not start without it
# (no shared default is provided, to avoid accidentally connecting to someone else's DB).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ora_test

# Required — random 32+ byte values, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# No hardcoded fallback exists for either: the app will not start without them.
SECRET_KEY=dev-local-secret
JWT_SECRET_KEY=dev-local-jwt-secret

# Gemini API key, used by the LangGraph orchestrator and the legacy ai_service.py
API_KEY=

# --- Amazon SES (all transactional email: welcome, verify-email, password reset) ---
AWS_REGION=ap-south-1
SES_SENDER_EMAIL=no-reply@notifications.teams-lab.com
# AWS credentials are read from the standard boto3 chain (env vars / IAM role / ~/.aws
# credentials) — not stored here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- OAuth (Google + Microsoft) — leave blank to disable a provider ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
OAUTH_REDIRECT_BASE_URL=http://localhost:5050

# --- Stripe (billing) — leave blank to disable checkout/portal/webhook endpoints ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

FRONTEND_BASE_URL=http://localhost:3000

# --- Circle Agent Wallet (Agentic Economy / USDC payments) — leave CIRCLE_API_KEY
# blank to run the Agent Economy in simulation mode (fake wallets/transfers, clearly
# flagged, no real funds move).
CIRCLE_API_KEY=
CIRCLE_API_BASE_URL=https://api-sandbox.circle.com
# Raw 32-byte entity secret as 64 hex chars — generate + register with
# backend/register_entity_secret.py before first real use.
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_BLOCKCHAIN=MATIC-AMOY
# USDC contract/token address on CIRCLE_BLOCKCHAIN (not a Circle "token ID").
CIRCLE_USDC_TOKEN_ADDRESS=
CIRCLE_WEBHOOK_SECRET=

# --- Google Cloud Storage (Document Vault file upload/download) ---
GCS_BUCKET_NAME=
# Path to a GCP service-account JSON key with Storage Object Admin on the bucket above.
# Read directly by the google-cloud-storage client, not by app code.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
